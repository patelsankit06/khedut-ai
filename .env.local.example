# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Rolling alias to Google's current free-tier flash model.
# Pin to a dated model id (e.g. gemini-2.5-flash) instead if you need reproducible answers.
GEMINI_CHAT_MODEL=gemini-flash-latest

# gemini-embedding-2 has different batching/taskType semantics - see src/lib/gemini/embeddings.ts before changing.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=rag_chunks

MAX_UPLOAD_MB=20
