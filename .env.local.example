# Default AI provider used when the sidebar toggle doesn't override it per
# request: "ollama" (offline, no key needed), "gemini" (needs GEMINI_API_KEY
# below), or "groq" (needs GROQ_API_KEY below - a fast fallback for when
# Gemini's free-tier quota runs out). The sidebar toggle lets you switch per
# session without restarting.
LLM_PROVIDER=ollama

# --- Ollama (offline) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Gemini (online) ---
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Groq (online, fast) ---
# Get a free API key from https://console.groq.com/keys
# Chat only - Groq has no embeddings API, so retrieval/citations for the Groq
# option reuse Gemini's embeddings and Chroma collection (GEMINI_API_KEY
# above must also be set for retrieval to work; Groq chat itself still works
# without it).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

CHROMA_URL=http://localhost:8000
# Separate collections per provider - Ollama's and Gemini's embedding models
# produce differently-sized vectors, so they can't share one collection.
CHROMA_COLLECTION_OLLAMA=khedut_chunks_ollama
CHROMA_COLLECTION_GEMINI=khedut_chunks_gemini

# --- Chroma Cloud (only if using it instead of a self-hosted/local Chroma) ---
# Leave these unset for local Docker or any self-hosted Chroma reachable via
# CHROMA_URL above. Set CHROMA_API_KEY to switch to Chroma Cloud instead -
# needed for hosts like Vercel that can't run the local Docker container.
# See README "Deploying to Vercel".
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

MAX_UPLOAD_MB=20
